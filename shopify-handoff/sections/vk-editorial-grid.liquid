{%- comment -%}
  ============================================================
  VK Editorial Grid — exemplar Shopify section
  ============================================================
  Covers index variants: B-B (2x2), B-B2 (wide feature + 2x1)
  Index spec : https://barreletics.github.io/vk-redesign-final/index-v2.html#body-secondary
  Live refs  :
    B-B / B-B2 — https://barreletics.github.io/vk-secondary-pages/hall-of-fame.html
    full-bleed — https://barreletics.github.io/vk-secondary-pages/legacy.html

  Repeatable blocks (max 4) become editorial cards. Layout preset
  controls the grid shape. Optional full-bleed band sits above the grid.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign layout     = section.settings.layout
  assign accent     = section.settings.accent_color
  assign accent_hex = '#D4860A'
  if accent == 'red'
    assign accent_hex = '#C0392B'
  endif
-%}

<section
  class="vk-edgrid vk-edgrid--{{ layout }}"
  style="--vk-accent: {{ accent_hex }};"
  {{ section.shopify_attributes }}
>
  {%- if section.settings.show_bleed and section.settings.bleed_headline != blank -%}
    <div class="vk-edgrid__bleed" role="figure" aria-label="{{ section.settings.bleed_headline | escape }}">
      {%- if section.settings.bleed_image != blank -%}
        {{
          section.settings.bleed_image
          | image_url: width: 1800
          | image_tag:
            loading: 'lazy',
            widths: '900,1200,1600,1800',
            sizes: '100vw',
            alt: section.settings.bleed_image.alt | default: section.settings.bleed_headline,
            class: 'vk-edgrid__bleed-img'
        }}
      {%- endif -%}
      <div class="vk-edgrid__bleed-inner">
        {%- if section.settings.bleed_eyebrow != blank -%}
          <p class="vk-edgrid__eyebrow vk-edgrid__eyebrow--light">{{ section.settings.bleed_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="vk-edgrid__bleed-h">{{ section.settings.bleed_headline | escape }}</h2>
        {%- if section.settings.bleed_body != blank -%}
          <p class="vk-edgrid__bleed-p">{{ section.settings.bleed_body }}</p>
        {%- endif -%}
        {%- if section.settings.bleed_cta_label != blank -%}
          <a class="vk-edgrid__bleed-cta" href="{{ section.settings.bleed_cta_url | default: '#' }}">
            {{- section.settings.bleed_cta_label | escape -}} →
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="vk-edgrid__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_class = 'vk-edgrid__tile'
          if layout == 'wide-2up' and forloop.first
            assign tile_class = 'vk-edgrid__tile vk-edgrid__tile--wide'
          endif
        -%}
        <article class="{{ tile_class }}" {{ block.shopify_attributes }}>
          <a class="vk-edgrid__media" href="{{ block.settings.link_url | default: '#' }}">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '500,700,900,1100',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  alt: block.settings.image.alt | default: block.settings.title,
                  class: 'vk-edgrid__img'
              }}
            {%- else -%}
              <div class="vk-edgrid__img vk-edgrid__img--placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </a>
          <div class="vk-edgrid__body">
            {%- if block.settings.eyebrow != blank -%}
              <p class="vk-edgrid__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="vk-edgrid__title">
                <a href="{{ block.settings.link_url | default: '#' }}">{{ block.settings.title | escape }}</a>
              </h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="vk-edgrid__copy">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="vk-edgrid__readmore" href="{{ block.settings.link_url | default: '#' }}">
                {{- block.settings.link_label | escape -}} →
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .vk-edgrid {
    --vk-near-black: #1A1A18;
    --vk-mid-grey: #6B6B68;
    --vk-hairline: rgba(26, 26, 24, 0.08);
    background: #fff;
    font-family: 'DM Sans', -apple-system, sans-serif;
    color: var(--vk-near-black);
    padding: 28px 0;
  }

  /* Full-bleed band */
  .vk-edgrid__bleed {
    position: relative;
    height: 360px;
    margin-bottom: 28px;
    overflow: hidden;
    background: linear-gradient(135deg, #3a3a36 0%, #1a1a18 100%);
  }
  .vk-edgrid__bleed-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }
  .vk-edgrid__bleed::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.35) 42%, rgba(0,0,0,0.75) 100%);
  }
  .vk-edgrid__bleed-inner {
    position: relative;
    z-index: 2;
    max-width: 760px;
    padding: 32px 36px 36px;
    align-self: flex-end;
    color: #fff;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .vk-edgrid__bleed-h {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 34px;
    font-weight: 600;
    line-height: 1.08;
    color: #fff;
    margin: 0 0 10px;
    text-shadow: 0 3px 24px rgba(0, 0, 0, 0.6);
  }
  .vk-edgrid__bleed-p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.6;
    max-width: 580px;
    margin: 0 0 14px;
  }
  .vk-edgrid__bleed-cta {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--vk-accent);
    text-decoration: none;
  }

  /* Grid */
  .vk-edgrid__grid {
    display: grid;
    gap: 22px;
    padding: 0 28px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .vk-edgrid--2x2 .vk-edgrid__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .vk-edgrid--wide-2up .vk-edgrid__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .vk-edgrid--wide-2up .vk-edgrid__tile--wide {
    grid-column: 1 / -1;
  }

  .vk-edgrid__tile { background: #fff; }
  .vk-edgrid__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, #cfc8be 0%, #9c9489 100%);
    margin-bottom: 16px;
  }
  .vk-edgrid__tile--wide .vk-edgrid__media { aspect-ratio: 21 / 9; }
  .vk-edgrid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .vk-edgrid__tile:hover .vk-edgrid__img { transform: scale(1.03); }
  .vk-edgrid__img--placeholder { background: transparent; }

  .vk-edgrid__body { padding: 0 4px; }
  .vk-edgrid__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--vk-accent);
    margin: 0 0 8px;
  }
  .vk-edgrid__eyebrow--light { color: #fff; }
  .vk-edgrid__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.18;
    margin: 0 0 8px;
  }
  .vk-edgrid__title a {
    color: inherit;
    text-decoration: none;
  }
  .vk-edgrid__title a:hover { color: var(--vk-accent); }
  .vk-edgrid__copy {
    font-size: 14px;
    line-height: 1.55;
    color: var(--vk-mid-grey);
    margin: 0 0 10px;
  }
  .vk-edgrid__readmore {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--vk-accent);
    text-decoration: none;
  }
  .vk-edgrid__readmore:hover { text-decoration: underline; }

  @media (max-width: 749px) {
    .vk-edgrid__grid { grid-template-columns: 1fr; padding: 0 16px; }
    .vk-edgrid__bleed { height: 280px; }
    .vk-edgrid__bleed-inner { padding: 20px 16px; }
    .vk-edgrid__bleed-h { font-size: 26px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "VK Editorial Grid",
  "tag": "section",
  "class": "vk-section-editorial",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Grid layout",
      "options": [
        { "value": "2x2",     "label": "B-B · 2×2 equal tiles" },
        { "value": "wide-2up","label": "B-B2 · Wide feature + 2-up" }
      ],
      "default": "2x2"
    },
    {
      "type": "select",
      "id": "accent_color",
      "label": "Accent",
      "options": [
        { "value": "amber", "label": "Amber" },
        { "value": "red",   "label": "VK Red" }
      ],
      "default": "amber"
    },

    {
      "type": "header",
      "content": "Optional full-bleed band (B-P style)",
      "info": "Sits above the grid. Toggle off if not needed."
    },
    { "type": "checkbox",     "id": "show_bleed",     "label": "Show full-bleed band", "default": false },
    { "type": "image_picker", "id": "bleed_image",    "label": "Background image" },
    { "type": "text",         "id": "bleed_eyebrow",  "label": "Eyebrow" },
    { "type": "text",         "id": "bleed_headline", "label": "Headline" },
    { "type": "richtext",     "id": "bleed_body",     "label": "Body" },
    { "type": "text",         "id": "bleed_cta_label","label": "CTA label" },
    { "type": "url",          "id": "bleed_cta_url",  "label": "CTA URL" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Editorial card",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image",      "label": "Image" },
        { "type": "text",         "id": "eyebrow",    "label": "Eyebrow",      "default": "Chapter One" },
        { "type": "text",         "id": "title",      "label": "Title",        "default": "How VK started — Mike Nehra, 1993" },
        { "type": "richtext",     "id": "body",       "label": "Body",         "default": "<p>A short, well-written paragraph that pulls the reader in.</p>" },
        { "type": "text",         "id": "link_label", "label": "Read-more label", "default": "Read the story" },
        { "type": "url",          "id": "link_url",   "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VK Editorial Grid — 2×2 (B-B)",
      "settings": { "layout": "2x2", "accent_color": "amber" },
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    },
    {
      "name": "VK Editorial Grid — wide + 2 (B-B2)",
      "settings": { "layout": "wide-2up", "accent_color": "amber" },
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
